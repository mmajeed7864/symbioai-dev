{
  "name": "symbio-ai-site",
  "version": "1.0.0",
  "private": true,
  "description": "Symbio AI marketing site — clean, DRY static build with Eleventy + Nunjucks.",
  "author": "Mohammed & Ravi",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve --quiet",
    "build": "npm run minify:widget && eleventy",
    "clean": "rimraf dist",
    "outreach": "node tools/audit-outreach.mjs",
    "hermes": "node tools/hermes/hermes.mjs",
    "source": "node tools/prospect-source.mjs",
    "new-client": "node tools/new-client.mjs",
    "set-stripe": "node tools/set-stripe.mjs",
    "minify:widget": "terser src/assets/js/symbio-widget.js -c -m -o src/assets/js/symbio-widget.min.js",
    "test": "node --test tests/*.test.mjs",
    "security:secrets": "node tools/security/scan-secrets.mjs",
    "security:audit": "npm run security:secrets && npm audit --omit=dev --audit-level=high",
    "eval:chat-model": "node tools/chat-model-eval.mjs",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:html",
    "lint:css": "stylelint \"src/assets/css/**/*.css\"",
    "lint:js": "eslint \"src/assets/js/**/*.js\" \"*.js\"",
    "lint:html": "htmlhint \"dist/**/*.html\"",
    "format": "prettier --write \"src/**/*.{css,js}\" \"*.{js,json,md}\" \"README.md\"",
    "format:check": "prettier --check \"src/**/*.{css,js}\" \"*.{js,json,md}\" \"README.md\""
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "htmlhint": "^1.1.4",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.51.2"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "nodemailer": "^9.0.6"
  }
}
