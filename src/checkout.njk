    summary: "An agent that works for you by drafting, routing, reminding, updating, and waiting for approval when needed.",
    ongoing: "Any model, hosting, or support costs are quoted before approval.",
    includes: ["Task map", "Approval gates", "Workflow queue", "Safety rules"]
  },
