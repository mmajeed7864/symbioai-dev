<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {% if baseHref %}<base href="{{ baseHref }}" />{% endif %}

    <title>{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }} - {{ site.tagline }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}" />

    <link rel="icon" href="assets/img/logo-symbio.svg" type="image/svg+xml" />

    {# Open Graph / social #}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    {# og:image must be a raster (PNG/JPG) — iMessage & most scrapers ignore SVG
       and fall back to an arbitrary large page image (e.g. a portfolio shot). #}
    <meta property="og:image" content="{{ ogImage or ((site.url + '/assets/img/og-card.png') if site.url else 'assets/img/og-card.png') }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {# Canonical + og:url — self-referencing absolute URL. A page may set its own
       `canonical`; otherwise we derive it from site.url + this page's path, so
       every page gets one. Guarded on site.url so an empty origin emits nothing. #}
    {% if site.url %}
      {% set pageCanonical = canonical or (site.url + page.url) %}
      <link rel="canonical" href="{{ pageCanonical }}" />
      <meta property="og:url" content="{{ pageCanonical }}" />
    {% endif %}

    {# Opt-in noindex for thin/gated pages (still follow links). #}
    {% if noindex %}<meta name="robots" content="noindex, follow" />{% endif %}

    {# JSON-LD structured data — only when a page provides `jsonLd` (the matrix
       landing pages do). Existing pages set nothing, so this stays silent. #}
    {% if jsonLd %}
      <script type="application/ld+json">{{ jsonLd | safe }}</script>
    {% endif %}

    {# Sitewide Organization schema — on every page that doesn't ship its own
       JSON-LD graph (the grow pages do). `| dump` keeps values JSON-safe. #}
    {% if site.url and not jsonLd %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "ProfessionalService",
          "@id": "{{ site.url }}/#org",
          "name": {{ site.name | dump | safe }},
          "url": {{ site.url | dump | safe }},
          "logo": {{ (site.url + "/assets/img/logo-symbio-color.svg") | dump | safe }},
          "image": {{ (site.url + "/assets/img/logo-symbio-color.svg") | dump | safe }},
          "description": {{ (site.description or site.tagline) | dump | safe }},
          "email": {{ (site.businessEmail or site.leadEmail or site.founders[0].email) | dump | safe }},
          "telephone": {{ ("+1-" + site.founders[0].phone) | dump | safe }},
          "areaServed": { "@type": "Country", "name": "United States" },
          "priceRange": "$$"
        }
      </script>
    {% endif %}

    {# Marketing pixels — off until the IDs are set in site.js. They power
       retargeting audiences; main.js forwards conversion events to them. #}
    {% if site.metaPixelId %}
      <script>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version="2.0";n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,"script","https://connect.facebook.net/en_US/fbevents.js");
        fbq("init", "{{ site.metaPixelId }}"); fbq("track", "PageView");
      </script>
    {% endif %}
    {% if site.googleAdsId %}
      <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.googleAdsId }}"></script>
      <script>
        window.dataLayer = window.dataLayer || []; function gtag(){ dataLayer.push(arguments); }
        gtag("js", new Date()); gtag("config", "{{ site.googleAdsId }}");
      </script>
    {% endif %}

    {# Runs before first paint. Sets the theme (localStorage wins, else the OS
       preference governs via CSS) and flags `.js` so reveal-on-scroll content
       starts hidden without a flash. A safety net unhides it if main.js never
       loads, so the page is never left with invisible content. #}
    <script>
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        try {
          var t = localStorage.getItem("symbio-theme");
          if (t === "light" || t === "dark") {
            d.setAttribute("data-theme", t);
          }
        } catch (e) {
          /* localStorage may be unavailable; fall back to CSS media query. */
        }
        window.addEventListener("load", function () {
          window.setTimeout(function () {
            if (!window.__symbioReady) d.classList.remove("js");
          }, 1500);
        });
      })();
    </script>

    {# Privacy-friendly analytics — enabled by setting site.analyticsDomain
       (Plausible, cookieless). main.js fires tagged conversion events. #}
    {% if site.analyticsDomain %}
      <script defer data-domain="{{ site.analyticsDomain }}" src="https://plausible.io/js/script.tagged-events.js"></script>
      <script>
        window.plausible = window.plausible || function () {
          (window.plausible.q = window.plausible.q || []).push(arguments);
        };
      </script>
    {% endif %}
    {% if site.analyticsScript %}<script defer src="{{ site.analyticsScript }}"></script>{% endif %}

    {# Worker base URL for fire-and-forget lead notifications (Telegram). #}
    <script>window.__symbioScanApi = {{ site.scanApi | dump | safe }};</script>

    <link rel="stylesheet" href="assets/css/styles.css?v=20260720-care-fees" />
    <link rel="stylesheet" href="assets/css/symbio-extra.css?v=20260714-cinematic" />
    {% if pageStylesheet %}<link rel="stylesheet" href="{{ pageStylesheet }}" />{% endif %}
    <script src="assets/js/main.js" defer></script>
    {% if extraScripts %}
      {% for script in extraScripts %}
        <script src="{{ script.src }}" {% if script.type %}type="{{ script.type }}"{% endif %}{% if script.defer %} defer{% endif %}></script>
      {% endfor %}
    {% endif %}
  </head>
  <body class="page page--{{ pageKey or 'default' }}">
    <a class="skip-link" href="#main">Skip to content</a>

    {% include "nav.njk" %}

    <main id="main" class="site-main">
      {{ content | safe }}
    </main>

    {% include "footer.njk" %}

    {# The embeddable assistant, loaded the way a customer would (one tag) and
       configured for Symbio itself. It stays a standalone file (not bundled into
       main.js); main.js bridges its leads to the scan endpoint and keeps its
       theme in sync with the site toggle. #}
    <script>
      window.SymbioConfig = {
        businessName: {{ site.name | dump | safe }},
        accent: "#2f6bff",
        services: [
          "Premium websites and redesigns",
          "Custom apps and portals",
          "Business dashboards",
          "Chatbots, voice agents, and AI workflow systems",
        ],
        hours: "24/7 intake and project support",
        location: "Founder-led from California and North Carolina, serving businesses across the entire US.",
        phone: {{ site.founders[0].phone | dump | safe }},
        secondaryPhone: {{ site.founders[1].phone | dump | safe }},
        primaryContactName: {{ site.founders[0].name | dump | safe }},
        secondaryContactName: {{ site.founders[1].name | dump | safe }},
        contactLabel: "Talk to a founder",
        email: {{ site.businessEmail | dump | safe }},
        freeScanEndpoint: {{ site.freeScanEndpoint | dump | safe }},
        price:
          "websites from $1,490 plus managed care from $79/month after launch; chatbots from $750; dashboards and workflow agents from $1,500; custom apps from $4,500; managed website assistants require a $690 setup plus a plan from $39/month; voice agents receive a custom quote based on call volume, integrations, and handoff rules",
        pricingMessage:
          "Websites start at $1,490, with managed care from $79/month after launch. Chatbots start at $750; dashboards and workflow agents at $1,500; custom apps at $4,500; and managed website assistants require a $690 setup plus a plan from $39/month. Customer-service voice agents are custom-quoted based on call volume, integrations, and handoff rules. The free scan helps confirm the right lane before you spend.",
        scanMessage:
          "The free scan is simple: send your website, Instagram, business page, or project idea. We look for the first fixes that can improve trust, mobile flow, speed, booking, calls, leads, or follow-up.",
        voiceMessage:
          "Yes. We build customer-service voice agents that answer routine calls, collect orders or requests, route booking and reschedule requests, qualify leads, summarize calls, and bring in a person when needed. Voice agents are custom-quoted based on call volume, integrations, and handoff rules. What business is it for, roughly how many calls do you receive, and which calls should reach a person?",
        chatbotMessage:
          "Yes. We can add a trained chatbot to your website. It can answer approved questions, explain your services, capture the visitor's name and contact information, qualify the request, route booking requests, and hand the conversation to a person. Custom chatbot builds start at $750. Our managed website assistant is a $690 setup plus a plan from $39/month. Do you already have a website, and what should the chatbot help customers with?",
        leadGenerationMessage:
          "Yes, we can help you build a better lead system. The usual setup combines a conversion-focused website or landing page with chatbot or voice intake and fast follow-up, so interested people do not disappear. If you already get traffic, we improve capture and follow-up; if you need traffic too, we first map the right outreach channel. No honest company can guarantee leads, but we can make the path measurable and much harder to lose. What business do you run, and where do customers currently find you?",
        websiteMessage:
          "Yes. We build premium websites and redesigns that make the offer clear, work properly on phones, build trust, and send visitors toward a call, booking, or enquiry. Website work starts at $1,490, with managed care from $79/month after launch. If you have an existing website or social page, send the link and tell me what you want customers to do.",
        appMessage:
          "Yes. We build custom apps, client portals, staff tools, and internal systems with the logins, roles, forms, uploads, dashboards, and workflows the business actually needs. Custom apps start at $4,500. Who would use the app, and what job should it make easier?",
        dashboardMessage:
          "Yes. We build business dashboards for leads, bookings, performance, follow-up status, and team activity. Dashboard builds start at $1,500. Tell me what information you track now and what decisions the dashboard should help you make.",
        automationMessage:
          "Yes. We build workflow automations and controlled AI agents for repeat tasks, routing, reminders, follow-up, updates, and approvals. Workflow-agent builds start at $1,500. We keep people in control of important actions. What work is your team repeating manually today?",
        maintenanceMessage:
          "We show recurring costs before a client approves anything. Managed website care starts at $79/month after launch. A managed website assistant requires a $690 setup plus a plan from $39/month. Voice usage, integrations, hosting, and any extra support are itemized for the specific build, so there are no surprise monthly charges.",
        guaranteeMessage:
          "No honest agency can guarantee a specific number of leads or sales. We can improve the offer, conversion path, intake, response speed, and follow-up, then measure what produces real conversations. The free scan helps identify where your current lead path is leaking.",
        recommendationMessage:
          "Tell me three things: what kind of business you run, what is going wrong now, and what you want customers or staff to do more easily. I will point you toward the smallest useful option: a website, chatbot, voice agent, app, dashboard, or workflow automation.",
        timelineMessage:
          "Focused landing pages and redesigns can move fast. Bigger websites, apps, dashboards, chatbots, voice agents, and workflow systems depend on scope and integrations. Send the starting point and we will give you a realistic timeline.",
        examplesMessage:
          "Our product demos cover websites, apps, dashboards, chatbots, voice-agent call flows, and workflow agents. Tell me which lane you are considering and I will point you toward the right example.",
        assistantInstructions:
          "Symbio AI is founder-led and serves businesses across the United States. Treat premium websites, custom apps, dashboards, chatbots, customer-service voice agents, and workflow agents as standalone offers. Voice agents are custom-quoted and should only promise actions supported by the approved call flow and integrations. Encourage a free project scan or founder follow-up when useful.",
        position: "right",
        theme: "auto",
        greeting:
          "Hey, this is Symbio AI. Send your website, app idea, dashboard need, chatbot or voice-agent plan, or workflow problem, and we will point you toward the right next step.",
      };
    </script>
    <script src="assets/js/symbio-widget.js" defer></script>
  </body>
</html>
