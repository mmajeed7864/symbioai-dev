{# ===== Who we help (slim strip) ====================================== #}
<section class="section section--tight">
  <div class="container">
    <p class="audience" data-reveal>
      <span class="audience__label">Built for</span>
      {% for who in site.whoWeHelp %}
        <span class="chip">{{ who }}</span>
      {% endfor %}
    </p>
  </div>
</section>

{# ===== Voice-agent product spotlight ================================== #}
<section class="section section--tight">
  <div class="container">
    <article class="voice-feature-card" data-reveal>
      <div class="voice-feature-card__copy">
        <span class="eyebrow">New: AI customer service by phone</span>
        <h2 class="section__title">Your business, answered - even when your team is busy.</h2>
        <p class="section__lead">
          Give routine callers a fast, natural first response. The voice agent can collect an
          order, qualify a request, help with scheduling, answer approved questions, or bring in
          a real person with the context already gathered.
        </p>
        <ul class="voice-feature-card__chips" aria-label="Voice agent capabilities">
          <li>Order intake</li>
          <li>Appointments</li>
          <li>Lead qualification</li>
          <li>Human handoff</li>
        </ul>
        <div class="btn-row mt-6">
          <a class="btn btn--primary" href="{{ site.links.voice }}">See the voice agent</a>
          <a class="btn btn--ghost" href="{{ site.cta.url }}">Map my call flow</a>
        </div>
      </div>

      <div class="voice-feature-card__console" aria-label="Example incoming-call workflow">
        <div class="voice-console__bar">
          <span><i aria-hidden="true"></i> Incoming customer call</span>
          <strong>00:42</strong>
        </div>
        <div class="voice-console__wave" aria-hidden="true">
          <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
        </div>
        <ol class="voice-console__steps">
          <li class="is-complete"><span>01</span>Understand the caller</li>
          <li class="is-active"><span>02</span>Take the right action</li>
          <li><span>03</span>Confirm or hand off</li>
        </ol>
        <div class="voice-console__outcome">
          <span>Call outcome</span>
          <strong>Order details ready for confirmation</strong>
        </div>
      </div>
    </article>
  </div>
</section>

{# ===== Product studio positioning ===================================== #}
<section class="section">
  <div class="container container--narrow center">
    <span class="eyebrow eyebrow--center" data-reveal>Pick the build</span>
