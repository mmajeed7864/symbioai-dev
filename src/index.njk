{# ===== 3D brand intro ================================================== #}
<section class="symbio-intro" data-symbio-intro aria-label="Symbio AI cinematic intro">
  <canvas class="symbio-intro__canvas" data-symbio-intro-canvas aria-hidden="true"></canvas>
  <div class="symbio-intro__grid" aria-hidden="true"></div>
  <div class="symbio-intro__scan" aria-hidden="true"></div>

  <div class="symbio-intro__boot" aria-hidden="true">
    <span data-symbio-intro-phase>Acquiring signal</span>
    <i><b data-symbio-intro-progress></b></i>
    <strong data-symbio-intro-percent>12%</strong>
  </div>

  <div class="symbio-intro__content">
    <div class="symbio-intro__mark-shell" aria-hidden="true">
      <img class="symbio-intro__mark" src="assets/img/logo-symbio-color.svg" alt="" width="112" height="112" />
    </div>
    <p class="symbio-intro__kicker">International AI engineers</p>
    <p class="symbio-intro__title" aria-label="Symbio AI">Symbio <span>AI</span></p>
    <p class="symbio-intro__line">Premium websites, apps, and agents that feel alive.</p>
    <div class="symbio-intro__actions">
      <button class="symbio-intro__enter" type="button" data-symbio-enter>Enter site</button>
      <button class="symbio-intro__skip" type="button" data-symbio-skip>Skip intro</button>
