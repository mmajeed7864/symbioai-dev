    summary: "A clean starter website, landing page, or focused redesign when the scope is simple and ready to move.",
    ongoing: "Managed website care from $79/mo starts when the site launches.",
    includes: ["Homepage or landing page", "Mobile-first layout", "Contact path", "Basic launch polish"]
  },
  {
    key: "premium-website",
    title: "Premium website",
    price: "$2,500-$6,500",
    deposit: "25% early deposit",
    turnaround: "1-7 days",
    summary: "A sharper multi-page site or deeper redesign with proof, booking paths, lead capture, and post-launch tuning.",
    ongoing: "Managed website care from $79/mo starts when the site launches.",
    includes: ["Multi-page build", "Conversion copy", "Booking or lead capture", "Two weeks of tuning"]
  },
  {
    key: "custom-app",
    title: "Custom app",
    price: "$2,000+",
    deposit: "30% early deposit",
    turnaround: "3-14 days",
    summary: "A real tool for logins, dashboards, portals, uploads, quotes, staff workflows, or internal operations.",
    ongoing: "Hosting and ongoing support, if needed, are quoted before approval.",
