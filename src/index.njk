    </div>
  </div>
</section>

{# ===== How it works =================================================== #}
<section class="section section--tint">
  <div class="container">
    <div class="section__head section__head--center" data-reveal>
      <span class="eyebrow eyebrow--center">How it works</span>
      <h2 class="section__title">From missed visitors to booked customers</h2>
      <p class="section__lead">
        A simple, honest process. We look first, explain what matters, then build only what helps.
      </p>
    </div>

    <ol class="grid grid--4">
      <li class="step" data-reveal>
        <span class="step__num">1</span>
        <h3 class="step__title">Scan</h3>
        <p class="step__text">
          We review your website, offer, mobile flow, forms, and first impression.
        </p>
      </li>
      <li class="step" data-reveal data-reveal-delay="1">
        <span class="step__num">2</span>
        <h3 class="step__title">Map</h3>
        <p class="step__text">We show the smallest set of fixes that can move revenue the most.</p>
      </li>
      <li class="step" data-reveal data-reveal-delay="2">
        <span class="step__num">3</span>
        <h3 class="step__title">Build</h3>
        <p class="step__text">
          We build the product lane that solves the problem: site, app, dashboard, chatbot, voice
          agent, or workflow agent.
        </p>
      </li>
      <li class="step" data-reveal data-reveal-delay="3">
        <span class="step__num">4</span>
        <h3 class="step__title">Polish</h3>
        <p class="step__text">We tune copy, speed, mobile flow, and calls to action until it feels ready.</p>
      </li>
    </ol>

    <div class="btn-row btn-row--center mt-6" data-reveal>
      <a class="btn btn--secondary" href="about.html">See our vision and process</a>
    </div>
  </div>
</section>

{# ===== What we build (services teaser) ================================ #}
<section class="section">
  <div class="container">
    <div class="section__head" data-reveal>
      <span class="eyebrow">What we build</span>
      <h2 class="section__title">Clear product lanes. Buy one by itself, or connect them later.</h2>
      <p class="section__lead">
        Start with a premium website, redesign, custom app, dashboard, chatbot, voice agent, or
        workflow agent. Each lane has a clear scope, useful demo, and honest next step.
      </p>
    </div>

    <div class="product-menu">
      {% for lane in site.productLanes %}
        <article class="product-card product-card--{{ lane.key }}{% if loop.first %} product-card--primary{% endif %}" data-reveal data-reveal-delay="{{ loop.index0 % 3 }}">
          <div class="product-card__topline">
            <span class="eyebrow">{{ lane.eyebrow }}</span>
            <span class="product-card__price">{{ lane.priceLabel or ("Starts at " + lane.startsAt) }}</span>
            {% if lane.compareAt %}<span class="product-card__compare">{{ lane.compareAt }}</span>{% endif %}
          </div>
          <h3 class="product-card__title">{{ lane.title }}</h3>
          <p class="product-card__text">{{ lane.summary }}</p>
          <ul class="product-card__features">
            {% for feature in lane.features %}
              <li>{{ feature }}</li>
            {% endfor %}
          </ul>
          <div class="product-card__actions">
            <a class="card__link" href="{{ lane.demoUrl }}">{{ lane.cta }}</a>
            <span class="product-card__typical">{% if lane.key == "voice" %}{{ lane.typical }}{% else %}Typical: {{ lane.typical }}{% endif %}</span>
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="btn-row btn-row--center mt-6" data-reveal>
      <a class="btn btn--secondary" href="services.html">See everything we can build</a>
      <a class="btn btn--ghost" href="pricing.html">Compare pricing anchors</a>
    </div>
  </div>
</section>

