          <h3>{{ useCase.title }}</h3>
          <p>{{ useCase.text }}</p>
          <span class="voice-use-case__example">{{ useCase.example }}</span>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{# ===== Trust and handoff ============================================ #}
<section class="section section--tight">
  <div class="container">
    <div class="voice-guardrail" data-reveal>
      <div>
        <span class="eyebrow">Human when it matters</span>
        <h2 class="section__title">Automation with a clear line back to your team</h2>
        <p class="section__lead">
          You define what the agent may handle, what needs confirmation, and when a caller should
          reach a person. Urgent or complex calls are routed with the context already gathered.
        </p>
